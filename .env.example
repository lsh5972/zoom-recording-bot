# Meeting SDK enabled General App: SDK authentication only.
ZOOM_SDK_CLIENT_ID=''
ZOOM_SDK_CLIENT_SECRET=''

# Server-to-Server OAuth app in the meeting host's Zoom account.
# Scopes: meeting:read:meeting:admin and user:read:token:admin
ZOOM_S2S_ACCOUNT_ID=''
ZOOM_S2S_CLIENT_ID=''
ZOOM_S2S_CLIENT_SECRET=''

# Approved recording user in the same Zoom account; not the meeting host.
ZOOM_BOT_USER_EMAIL=''

# Build this local native worker image before running the bot.
ZOOM_BOT_IMAGE='zoom-bot-worker:local'

# Each finalized WAV is sent as multipart metadata(JSON) + audio(WAV).
# Leave empty to capture locally without delivery.
ZOOM_CHUNK_ENDPOINT=''
# Optional receiving API token, without "Bearer "; unrelated to Zoom credentials.
ZOOM_CHUNK_BEARER_TOKEN=''
