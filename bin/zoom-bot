#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/zoom_bot'

begin
  command = ARGV.shift
  case command
  when 'check'
    ZoomBot::Settings.new
    puts 'Required credential variables are present. No Zoom authentication or SDK test performed.'
  when 'prepare', 'run'
    raise ZoomBot::Error, "Usage: bin/zoom-bot #{command} MEETING_ID" unless ARGV.length == 1
    meeting_id = ZoomBot::SessionPreparer.normalize_id(ARGV.first)
    settings = ZoomBot::Settings.new
    if command == 'run'
      supervisor = ZoomBot::BotSupervisor.new(image: ENV['ZOOM_BOT_IMAGE'])
      supervisor.check_image!
    end
    tokens = ZoomBot::AccessTokenProvider.new(settings)
    api = ZoomBot::ZoomApiClient.new(tokens)
    signatures = ZoomBot::SdkSignature.new(settings)
    preparer = ZoomBot::SessionPreparer.new(api, signatures, root: File.expand_path('../runs', __dir__))
    session = preparer.prepare(meeting_id)
    if command == 'run'
      name = supervisor.start(session)
      puts "Container launched: #{name}. Meeting admission and recording permission are not yet verified."
    else
      puts 'Host ZAK and SDK JWT prepared. No bot has joined a meeting.'
    end
    puts "Session: #{session.fetch(:session_id)}"
    puts "Private files: #{session.fetch(:directory)}"
  when 'stop'
    raise ZoomBot::Error, 'Usage: bin/zoom-bot stop SESSION_ID' unless ARGV.length == 1
    ZoomBot::BotSupervisor.new(image: 'unused').stop(ARGV.first)
    puts 'Container stopped. Output files retained.'
  else
    warn 'Usage: ruby bin/zoom-bot check | prepare MEETING_ID | run MEETING_ID | stop SESSION_ID'
    exit 1
  end
rescue ZoomBot::Error, Errno::ENOENT, Errno::EACCES => error
  warn error.message
  exit 1
end
