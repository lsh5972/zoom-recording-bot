#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/zoom_bot'

begin
  command = ARGV.shift
  case command
  when 'check'
    ZoomBot::Settings.new
    puts 'Required environment variables are present. No Zoom authentication or SDK test performed.'
  when 'prepare', 'run'
    raise ZoomBot::Error, "Usage: bin/zoom-bot #{command} MEETING_ID" unless ARGV.length == 1
    meeting_id = ZoomBot::SessionPreparer.normalize_id(ARGV.first)
    settings = ZoomBot::Settings.new
    if command == 'run'
      supervisor = ZoomBot::BotSupervisor.new(image: ENV['ZOOM_BOT_IMAGE'])
      supervisor.check_image!
    end
    tokens = ZoomBot::AccessTokenProvider.new(settings)
    api = ZoomBot::ZoomApiClient.new(tokens)
    signatures = ZoomBot::SdkSignature.new(settings)
    preparer = ZoomBot::SessionPreparer.new(api, signatures, root: File.expand_path('../runs', __dir__),
                                          bot_user_email: settings.fetch('ZOOM_BOT_USER_EMAIL'),
                                          display_name: settings.fetch('ZOOM_BOT_DISPLAY_NAME'),
                                          screenshot_interval_seconds: settings.fetch('ZOOM_SCREENSHOT_INTERVAL_SECONDS'))
    session = preparer.prepare(meeting_id)
    if command == 'run'
      supervisor.start(session)
      puts 'Container launched. Meeting admission and recording permission are not yet verified.'
    else
      puts 'Bot user ZAK and SDK JWT prepared. No bot has joined a meeting.'
    end
    puts "Meeting: #{session.fetch(:meeting_id)}"
    puts "Private files: #{session.fetch(:directory)}"
  when 'stop'
    raise ZoomBot::Error, 'Usage: bin/zoom-bot stop MEETING_ID' unless ARGV.length == 1
    session = ZoomBot::SessionPreparer.locate(ARGV.first, root: File.expand_path('../runs', __dir__))
    ZoomBot::BotSupervisor.new(image: 'unused').stop(session.fetch(:session_id))
    puts 'Container stopped. Output files retained.'
  when 'deliver'
    watch = ARGV.delete('--watch')
    raise ZoomBot::Error, 'Usage: bin/zoom-bot deliver MEETING_ID [--watch]' unless ARGV.length == 1
    session = ZoomBot::SessionPreparer.locate(ARGV.first, root: File.expand_path('../runs', __dir__))
    client = ZoomBot::ChunkHttpClient.new(endpoint: ENV['ZOOM_CHUNK_ENDPOINT'],
                                         bearer_token: ENV['ZOOM_CHUNK_BEARER_TOKEN'])
    output = File.join(session.fetch(:directory), 'output')
    sender = ZoomBot::ChunkDelivery.new(output: output, client: client)
    retry_delay = 1
    loop do
      begin
        delivered = sender.drain
        puts "Delivered #{delivered} WAV chunk(s)." if delivered.positive? || !watch
        retry_delay = 1
        break unless watch

        sleep 0.25
      rescue ZoomBot::DeliveryError => error
        raise unless watch && error.retryable

        warn "#{error.message}. Retry in #{retry_delay}s."
        sleep retry_delay
        retry_delay = [retry_delay * 2, 60].min
      end
    end
  else
    warn 'Usage: ruby bin/zoom-bot check | prepare MEETING_ID | run MEETING_ID | stop MEETING_ID | deliver MEETING_ID [--watch]'
    exit 1
  end
rescue ZoomBot::Error, Errno::ENOENT, Errno::EACCES => error
  warn error.message
  exit 1
end
